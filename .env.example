# Pin the Miniflux instance this deployment accepts. When set, the proxy, the settings sync
# and the helper endpoints reject any other X-Miniflux-Server value (403). Leave empty to run
# as an open hosted client where each user brings their own Miniflux server URL + API token.
ALLOWED_MINIFLUX_SERVER=

# Directory for the per-user settings blobs written by /api/settings (default: ./data).
# In Docker this is the settings-data volume mounted at /app/data.
SETTINGS_DATA_DIR=
